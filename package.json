{
  "name": "moodlia-portable",
  "version": "0.1.0",
  "private": true,
  "description": "A self-contained local Moodle authoring desktop app",
  "homepage": "https://moodlia.com",
  "author": "Pablo Gallego",
  "license": "GPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "python -m unittest discover -s tests -v && node --check desktop/main.cjs",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.moodlia.portable",
    "productName": "MoodlIA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/portable",
        "to": "portable"
      }
    ],
    "artifactName": "MoodlIA-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "desktop/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "include": "installer/safety.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MoodlIA-Setup-${version}-${arch}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "icon": "desktop/icon.png",
      "target": [
        "deb",
        "rpm",
        "AppImage",
        "tar.gz"
      ],
      "category": "Education",
      "maintainer": "Pablo Gallego"
    }
  }
}
